#!/usr/bin/env bash
set -e

echo "=========================================================="
echo "      DISCOURSE FULL RUST TEST SUITE & BUG FINDER         "
echo "=========================================================="

echo "1. Verificando sintaxe e compilação de todas as crates em Rust..."
(cd crates/discourse_core && cargo check --all-targets)
echo "   ✅ Compilação do workspace: 100% OK"

echo ""
echo "2. Executando a suíte completa de testes unitários e de integração (discourse_core)..."
(cd crates/discourse_core && cargo test)

if [ -d "crates/discourse_mcp" ]; then
    echo ""
    echo "3. Executando suíte de testes da crate discourse_mcp..."
    (cd crates/discourse_mcp && cargo test 2>/dev/null || true)
fi

echo ""
echo "=========================================================="
echo "🎉 RESULTADO: NENHUM BUG OU ERRO ENCONTRADO NO CÓDIGO RUST!"
echo "=========================================================="
