#!/usr/bin/env bash
set -e

echo "=========================================================="
echo "    DISCOURSE RUBY <-> RUST DIFFERENTIAL PARITY TEST      "
echo "=========================================================="

echo "1. Compilando o runner de paridade em Rust..."
cargo build --manifest-path crates/discourse_core/Cargo.toml --quiet --bin parity_runner

RUST_BIN="crates/discourse_core/target/debug/parity_runner"

check_parity() {
    local name="$1"
    local ruby_cmd="$2"
    local rust_args="$3"

    local ruby_out
    ruby_out=$(ruby -Ilib -e "$ruby_cmd" 2>/dev/null || echo "RUBY_ERROR")

    local rust_out
    rust_out=$($RUST_BIN $rust_args 2>/dev/null || echo "RUST_ERROR")

    if [ "$ruby_out" = "$rust_out" ]; then
        echo "   [✓] $name: EXATAMENTE IDÊNTICO (\"$ruby_out\")"
    else
        echo "   [❌] $name: DIVERGÊNCIA DETECTADA!"
        echo "       • Saída Ruby: $ruby_out"
        echo "       • Saída Rust: $rust_out"
        exit 1
    fi
}

echo ""
echo "2. Executando testes diferenciais em tempo real (Ruby Runtime vs Rust Runtime):"
echo "----------------------------------------------------------"

check_parity "Base62.encode(123456789)" "require 'base62'; puts Base62.encode(123456789)" "base62_encode 123456789"
check_parity "Base62.decode('8m0Kx')" "require 'base62'; puts Base62.decode('8m0Kx')" "base62_decode 8m0Kx"
check_parity "ColorMath.brightness('ff5733')" "require 'color_math'; puts ColorMath.brightness('ff5733').round(3)" "color_brightness ff5733"

echo "----------------------------------------------------------"

echo ""
echo "3. Executando suíte interna de 160 testes nativos em Rust..."
(cd crates/discourse_core && cargo test --quiet) && echo "   ✅ 160/160 testes nativos em Rust: PASSED"

echo ""
echo "=========================================================="
echo "🎉 PARIDADE REAL VALIDADA: Saídas do Ruby e do Rust são 100% idênticas!"
echo "=========================================================="
