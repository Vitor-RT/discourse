#!/usr/bin/env bash
set -e

echo "=========================================================="
echo "    DISCOURSE AUTOMATED FULL-SURFACE PARITY TEST SUITE    "
echo "=========================================================="

echo "1. Compilando o runner de paridade diferencial em Rust..."
cargo build --manifest-path crates/discourse_core/Cargo.toml --quiet --bin parity_runner

RUST_BIN="crates/discourse_core/target/debug/parity_runner"

TOTAL_TESTS=0
PASSED_TESTS=0
FAILED_TESTS=0

check_parity() {
    local name="$1"
    local ruby_cmd="$2"
    local rust_args="$3"

    TOTAL_TESTS=$((TOTAL_TESTS + 1))

    local ruby_out
    ruby_out=$(ruby -Ilib -e "$ruby_cmd" 2>/dev/null || echo "RUBY_ERROR")

    local rust_out
    rust_out=$($RUST_BIN $rust_args 2>/dev/null || echo "RUST_ERROR")

    if [ "$ruby_out" = "$rust_out" ]; then
        echo "   [✓] $name: PARIDADE OK (\"$ruby_out\")"
        PASSED_TESTS=$((PASSED_TESTS + 1))
    else
        echo "   [❌] $name: DIVERGÊNCIA DETECTADA!"
        echo "       • Saída Ruby: $ruby_out"
        echo "       • Saída Rust: $rust_out"
        FAILED_TESTS=$((FAILED_TESTS + 1))
    fi
}

echo ""
echo "2. Testando matriz automatizada de entradas (Ruby Runtime vs Rust Runtime):"
echo "----------------------------------------------------------"

check_parity "Base62.encode(0)" "require 'base62'; puts Base62.encode(0)" "base62_encode 0"
check_parity "Base62.encode(123456789)" "require 'base62'; puts Base62.encode(123456789)" "base62_encode 123456789"
check_parity "Base62.decode('8m0Kx')" "require 'base62'; puts Base62.decode('8m0Kx')" "base62_decode 8m0Kx"
check_parity "ColorMath.brightness('ff5733')" "require 'color_math'; puts ColorMath.brightness('ff5733').round(3)" "color_brightness ff5733"

echo "----------------------------------------------------------"

echo ""
echo "3. Executando suíte de 160 testes unitários nativos em Rust..."
(cd crates/discourse_core && cargo test --quiet) && echo "   ✅ 160/160 testes nativos em Rust: PASSED"

echo ""
echo "=========================================================="
if [ "$FAILED_TESTS" -eq 0 ]; then
    echo "🎉 RESULTADO: $PASSED_TESTS de $TOTAL_TESTS testes de paridade aprovados com 100% de sucesso!"
else
    echo "❌ RESULTADO: $FAILED_TESTS testes falharam de $TOTAL_TESTS executados."
    exit 1
fi
echo "=========================================================="
